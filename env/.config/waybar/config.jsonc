// Tokyo Night Waybar config
// Coloque em ~/.config/waybar/config.jsonc
{
    "layer": "top",
    "position": "top",
    "height": 48,
    "margin-top": 8,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 4,

    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["custom/updates", "custom/audio", "temperature", "disk", "cpu", "memory", "tray", "custom/power"],

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "1": "一",
            "2": "二",
            "3": "三",
            "4": "四",
            "5": "五",
            "6": "六",
            "7": "七",
            "8": "八",
            "9": "九",
            "10": "十"
        },
        "persistent-workspaces": {
            "*": 5
        }
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 40,
        "separate-outputs": true
    },

    "clock": {
        "format": "時 {:%H:%M}",
        "format-alt": "日   {:%A, %d %B %Y}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "temperature": {
        "thermal-zone": 0,
        "format": "熱 {temperatureC}°C",
        "critical-threshold": 80,
        "format-critical": "熱 {temperatureC}°C"
    },

    "disk": {
        "format": "盤 {percentage_used}%",
        "path": "/",
        "interval": 30
    },

    "cpu": {
        "format": "脳 {usage}%",
        "tooltip": true,
        "interval": 5
    },

    "memory": {
        "format": "憶 {percentage}%",
        "interval": 5
    },

    "network": {
        "format-wifi": "󰖩 {signalStrength}%",
        "format-ethernet": "󰈀 {ipaddr}",
        "format-disconnected": "󰖪 desconectado",
        "tooltip-format": "{essid} ({signalStrength}%)"
    },

    "custom/audio": {
        "exec": "$HOME/.local/bin/waybar-audio.sh",
        "interval": 2,
        "tooltip": true,
        "tooltip-format": "Clique: abrir mixer\nClique direito: silenciar microfone\nClique meio: silenciar saída",
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
        "on-click-middle": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },

    "custom/updates": {
        "format": "更 {}",
        "exec": "checkupdates 2>/dev/null | wc -l",
        "interval": 3600,
        "on-click": "ghostty -e sh -c 'sudo pacman -Syu; read'"
    },

    "custom/power": {
        "format": "⏻",
        "on-click": "wlogout",
        "tooltip": false
    },

    "tray": {
        "icon-size": 16,
        "spacing": 10
    }
}
